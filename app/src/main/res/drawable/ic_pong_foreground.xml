<?xml version="1.0" encoding="utf-8"?>
<!--
  X3Pong launcher mark.

  Two paddles and a ball on a dashed center line — the actual game, not a
  borrowed shooting-gallery icon. 108dp viewport; safe zone is the middle 66dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Court border -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#2200F5FF"
        android:strokeWidth="2"
        android:pathData="M18,20 L90,20 L90,88 L18,88 Z" />

    <!-- Dashed center net -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#66FFFFFF"
        android:strokeWidth="2.5"
        android:pathData="M54,24 L54,30 M54,38 L54,44 M54,52 L54,58 M54,66 L54,72 M54,80 L54,84" />

    <!-- Left paddle (cyan) -->
    <path
        android:strokeColor="#00F5FF"
        android:strokeWidth="4"
        android:fillColor="#8000F5FF"
        android:strokeLineJoin="round"
        android:pathData="M27,40 h6 v24 h-6 z" />

    <!-- Right paddle (magenta) -->
    <path
        android:strokeColor="#FF2DD6"
        android:strokeWidth="4"
        android:fillColor="#80FF2DD6"
        android:strokeLineJoin="round"
        android:pathData="M75,44 h6 v24 h-6 z" />

    <!-- Ball, mid-rally with a short motion trail -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.5"
        android:strokeAlpha="0.5"
        android:fillColor="#00000000"
        android:pathData="M40,34 L58,54" />
    <path
        android:strokeColor="#FFE84A"
        android:strokeWidth="4"
        android:fillColor="#FFE84A"
        android:pathData="M62,58 m-6,0 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0" />
</vector>
